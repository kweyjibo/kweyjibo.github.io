{% macro devnotesList(devnotes, showTags = true) %}
  {% for post in devnotes %}
    <article class="devnotes-item">
        {% if showTags %}
          <div class="tags">
            {% for tag in post.data.tags %}
              {% if tag != "work" and tag != "blog" %}
                <span class="tag_i">
                  <a href="/work/{{ tag | slugify }}/" class="tag_lk">
                    {{ tag }}
                  </a>
                </span>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
        <div class="devnotes-item__inner">
          <a class="devnotes-item__lk" href="{{ post.url }}">
            <h2 class="devnotes-item__title">{{ post.data.title }}</h2>
            <span class="devnotes-item__desc">
              {{ post.data.dsc }}
            </span>
          </a>
        </div>
    </article>
  {% endfor %}
{% endmacro %}