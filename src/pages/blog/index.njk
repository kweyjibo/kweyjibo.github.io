---
title: Blog
pagination:
  data: collections.blog
  size: 5
permalink: "{% if pagination.pageNumber > 0 %}{{ pagination.pageNumber + 1 }}/{% endif %}blog/index.html"
eleventyNavigation:
  key: Blog
  order: 2
layout: page.njk
---

{% for blog in pagination.items %}

<article class="article-item">
  {% if blog.data.image %}
  <div class="article-item_cover">
    <figure class="article-item_figure">
      <a href="{{ blog.url }}"><img
        src="{{ blog.url }}{{ blog.data.image }}"
        alt="{{ blog.data.title }}"
        width="{{ blog.data.imageProp }}"
        class="article-item_img"
      /></a>
    </figure>
  </div>
  {% endif %}
  <section
    class="article-item_content {% if not(blog.data.image) %}__shift{% endif %}"
  >
    <div class="tags">
      {% for tag in blog.data.tags %} {% if tag != "posts" %}
      <span class="tag_i">
        <a href="/tags/{{ tag | slugify }}" class="tag_lk">
          {{ tag }}
        </a>
      </span>
      {% endif %} {% endfor %}
    </div>
    <h1 class="article-item_title">
      <a class="article-item_lk" href="{{ blog.url }}">{{ blog.data.title }}</a>
    </h1>
    <div class="article-item__desc">
      {{ blog.data.dsc }}
    </div>
    
    <footer class="article-item__footer">
      <time class="article-item_date" datetime="{{ blog.date }}">{{ blog.date | dateShort }}</time>
      <span class="article-item_read">{{ blog.content | readTime }} min read</span>
    </footer>
  </section>
</article>

{% endfor %} {% include "paginator.njk" %}
