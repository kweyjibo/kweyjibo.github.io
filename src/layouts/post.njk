---
layout: page.njk
title: Blog
---

<article class="article">
  <section class="island flex">
    <div class="back-button__cnt">
      <a
        href="{{ sectionUrl }}"
        class="back-button"
        onclick="if (document.referrer.startsWith(location.origin)) { event.preventDefault(); history.back(); }"
      >
        &larr; Back
      </a>
    </div>
    {% include 'tags.njk' %}
  </section>
  <header class="article-header">
    
    <h1 class="article-title">
      {{ title }}
    </h1>

    <time class="article-date" datetime="{{ date }}">{{
      date | dateShort
    }}</time>

    <div class="view-count" id="view-count">
      <img src="/assets/img/icons/view.svg" width="24" height="24" />
    </div>
  </header>

  <section class="article-content">
    {{ content | safe }}
  </section>

  {% include 'remark42.njk' %}
  <div class="island"><div id="remark42"></div></div>
</article>
